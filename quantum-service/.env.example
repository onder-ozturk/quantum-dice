# Copy to .env (gitignored) for local dev, or set these as host env vars in production.
# Leave IBM_QUANTUM_TOKEN empty to run Aer-only (the /backends endpoint will report ibm as unavailable).
IBM_QUANTUM_TOKEN=
# "ibm_quantum" (legacy) or "ibm_cloud" depending on your IBM Quantum account.
IBM_CHANNEL=ibm_quantum
# Optional pinned instance "hub/group/project".
IBM_INSTANCE=
IBM_TIMEOUT_S=18
DEFAULT_BACKEND=aer
DEFAULT_SHOTS=64
